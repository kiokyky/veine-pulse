  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --require ./tests/mock-expo.cjs --test .test-dist/tests/*.test.js && rm -rf .test-dist",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
